import os
import json
import zlib
import logging
from typing import Any, List, Union, Optional

import file_utils
from base_plugin import BasePlugin, MethodReplacement, MethodHook
from hook_utils import get_private_field
from client_utils import get_messages_controller, get_last_fragment
from android_utils import log as _internal_log
from ui.settings import Header, Text
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper

from java import jclass
from org.telegram.tgnet import TLRPC

__id__ = "user_info_saver"
__name__ = "UserInfoSaver"
__icon__ = "zwyPluginsIcons/7"
__description__ = (
    "Saves user's short info (phone country, registration date, etc) before server doesn't return it more."
)
__author__ = "@zwylair"
__version__ = "1.0.1"
__min_version__ = "12.0.1"

# Fields that must never be written back onto a TL_peerSettings object via
# reflection: on some client builds (e.g. nagram XF), 'constructor' is
# enforced as a Java `final` field, and setattr()'ing it throws
# "TL_peerSettings.constructor is a final field", which silently aborted
# get_peer_settings() for EVERY chat that had cached/dumped data - this was
# why the info box never appeared for users the server stopped returning
# data for.
NON_WRITABLE_FIELDS = ("constructor",)


class _CustomLogger(logging.Logger):
    def _log(self, level, msg, args, exc_info=None, extra=None, stack_info=False, stacklevel=1):
        level_name = logging.getLevelName(level)
        prefix = f"[{level_name}] [{self.name}]"
        formatted_msg = f"{msg} {' '.join(map(str, args))}".strip()
        final_output = f"{prefix} {formatted_msg}"

        if exc_info:
            import traceback
            tb = traceback.format_exc() if exc_info is True else "".join(
                traceback.format_exception(type(exc_info), exc_info, exc_info.__traceback__)
            )
            final_output += f"\n{tb.strip()}"

        _internal_log(final_output)


def build_log(plugin_name: str, level=logging.NOTSET) -> logging.Logger:
    manager = logging.Logger.manager

    if plugin_name in manager.loggerDict:
        old_logger = manager.loggerDict[plugin_name]
        if hasattr(old_logger, "handlers"):
            old_logger.handlers.clear()
        del manager.loggerDict[plugin_name]

    logging.setLoggerClass(_CustomLogger)
    new_logger = logging.getLogger(plugin_name)
    if level != logging.NOTSET:
        new_logger.setLevel(level)
    if not isinstance(new_logger, _CustomLogger):
        new_logger.__class__ = _CustomLogger
    return new_logger


class JsonCacheFile:
    def __init__(self, filename: str, default, compress: bool = False):
        self._default = default
        self.compress = compress

        plugins_dir = file_utils.get_plugins_dir()
        cache_dir = os.path.join(plugins_dir, "cache")
        os.makedirs(cache_dir, exist_ok=True)
        self.path = os.path.join(cache_dir, filename)

        self.json_content = self._read()

    def _read(self):
        if not os.path.exists(self.path):
            return json.loads(json.dumps(self._default))

        try:
            with open(self.path, "rb") as f:
                raw = f.read()

            if not raw:
                return json.loads(json.dumps(self._default))

            is_zlib = (
                len(raw) >= 2
                and (raw[0] & 0x0F) == 8
                and (raw[0] * 256 + raw[1]) % 31 == 0
            )
            if is_zlib:
                try:
                    raw = zlib.decompress(raw)
                except zlib.error:
                    logger.error("Failed to decompress cache file, resetting.", exc_info=True)
                    return json.loads(json.dumps(self._default))

            return json.loads(raw.decode("utf-8", errors="replace"))
        except Exception:
            logger.error(f"Failed to load data from '{self.path}':", exc_info=True)
            return json.loads(json.dumps(self._default))

    def write(self):
        try:
            data = json.dumps(self.content).encode("utf-8")
            if self.compress:
                data = zlib.compress(data, level=6)
            with open(self.path, "wb") as f:
                f.write(data)
        except Exception:
            logger.error(f"Failed to write data to '{self.path}':", exc_info=True)

    @property
    def content(self):
        return self.json_content

    @content.setter
    def content(self, value):
        self.json_content = value


def hook_max_args_overload(plugin_instance, clazz, method_name: str, hook_instance):
    method = max(
        [m for m in clazz.getDeclaredMethods() if m.getName() == method_name],
        key=lambda m: m.getParameterCount(),
        default=None,
    )

    if not method:
        logger.warning(f"Failed to hook {method_name}: no matching method found.")
        return

    method.setAccessible(True)
    plugin_instance.hook_method(method, hook_instance)


def settings_has_necessary_field(settings: Optional[TLRPC.TL_peerSettings | dict]) -> bool:
    if isinstance(settings, dict):
        return settings.get("phone_country") is not None
    return getattr(settings, "phone_country", None) is not None


def peer_settings_to_dict(settings: Optional[TLRPC.TL_peerSettings]) -> Optional[dict[str, Union[str, int, bool]]]:
    if not settings:
        return None

    data = {}
    for field in settings.getClass().getFields():
        key: str = field.getName()
        if not key.islower() or key.startswith("_") or key in NON_WRITABLE_FIELDS:
            continue
        data[key] = field.get(settings)
    return data


def dict_to_peer_settings(dumped: Optional[dict[str, Union[str, int, bool]]]) -> Optional[TLRPC.TL_peerSettings]:
    if not dumped:
        return None

    settings = TLRPC.TL_peerSettings()
    for k, v in dumped.items():
        if k in NON_WRITABLE_FIELDS:
            continue
        try:
            setattr(settings, k, v)
        except Exception:
            # Some fields may be non-writable on certain client builds
            # (e.g. 'constructor' is `final` on nagram XF). Skip rather
            # than let one bad field kill the whole restore.
            logger.debug(f"Skipping non-writable field '{k}'")
    return settings


def load_peer_settings(dialog_id: int) -> Optional[dict[str, Union[str, int, bool]]]:
    if str(dialog_id) in storage.content:
        return storage.content[str(dialog_id)]
    return None


def save_peer_settings(dialog_id: int, settings: TLRPC.TL_peerSettings):
    new_settings = peer_settings_to_dict(settings)
    old_settings = load_peer_settings(dialog_id)

    if old_settings:
        for field in PRECIOUS_FIELDS:
            new_val = new_settings.get(field)
            if not new_val and old_settings.get(field):
                new_settings[field] = old_settings[field]

    logger.debug("Saved: ", new_settings)
    storage.content[str(dialog_id)] = new_settings
    storage.write()


def get_peer_settings(dialog_id: int) -> Optional[TLRPC.TL_peerSettings]:
    msg_controller = get_messages_controller()

    user_full = msg_controller.getUserFull(dialog_id)
    if settings_has_necessary_field(user_full_settings := getattr(user_full, "settings", None)):
        logger.debug("Loaded from user_full.")
        return user_full_settings

    user_peer_settings = get_private_field(msg_controller, "userPeerSettings")
    if settings_has_necessary_field(msg_controller_settings := user_peer_settings.get(dialog_id)):
        logger.debug("Loaded from tg's array.")
        return msg_controller_settings

    if settings_has_necessary_field(generated_settings := load_peer_settings(dialog_id)):
        logger.debug("Loaded from plugin storage.")
        return dict_to_peer_settings(generated_settings)
    return user_full_settings or msg_controller_settings or dict_to_peer_settings(generated_settings)


class SavePeerSettings(MethodHook):
    def before_hooked_method(self, param):
        logger.debug("SavePeerSettings hook called.")
        try:
            save_peer_settings(param.args[0], param.args[1])
        except Exception:
            logger.error("An error occurred:", exc_info=True)


class LoadPeerSettings(MethodReplacement):
    def replace_hooked_method(self, param):
        logger.debug("LoadPeerSettings hook called.")
        try:
            return get_peer_settings(param.args[0])
        except Exception:
            logger.error("An error occurred:", exc_info=True)


PRECIOUS_FIELDS = ("registration_month", "phone_country", "name_change_date", "photo_change_date")

storage = JsonCacheFile("zwyUserInfoSaver__peer_settings_storage", default={}, compress=True)
logger = build_log(__name__)

# --- Backup restore helpers -------------------------------------------------
#
# Restoring writes through storage.write(), so the file on disk keeps using
# whatever format storage already uses (zlib-compressed, matching the
# original behavior) - no separate .json file is created.


def _backup_search_dirs() -> list[str]:
    dirs = [os.path.join(file_utils.get_plugins_dir(), "cache")]
    try:
        docs_dir = file_utils.get_documents_dir()
        if docs_dir:
            dirs.append(docs_dir)
    except Exception:
        logger.error("Failed to resolve documents dir:", exc_info=True)
    return dirs


def find_backup_candidates() -> list[str]:
    """Look for restorable backup files in the plugin cache and Documents dirs.

    The original storage file has no extension, so this doesn't filter by
    extension - it lists files and lets _decode_backup_bytes() validate
    whether a given file actually looks like a saved-settings dump.
    """
    candidates: list[str] = []
    seen = set()

    for directory in _backup_search_dirs():
        try:
            found = file_utils.list_dir(path=directory, include_files=True, include_dirs=False) or []
        except Exception:
            found = []

        for f in found:
            if f not in seen:
                seen.add(f)
                candidates.append(f)

    def _norm(p: str) -> str:
        # realpath resolves symlinks (e.g. /sdcard -> /storage/emulated/0 on Android),
        # normcase handles case-insensitive filesystems.
        return os.path.normcase(os.path.realpath(p))

    active_norm = _norm(storage.path)
    active_dir_norm = _norm(os.path.dirname(storage.path))
    active_name_norm = os.path.normcase(os.path.basename(storage.path))

    result = []
    for c in candidates:
        # Exclude by resolved full-path match, and as a fallback, exclude any
        # file with the same name sitting in the same resolved directory as
        # the active storage file (covers path-string mismatches).
        if _norm(c) == active_norm:
            continue
        if _norm(os.path.dirname(c)) == active_dir_norm and os.path.normcase(os.path.basename(c)) == active_name_norm:
            continue
        result.append(c)
    return result


def _decode_backup_bytes(raw: bytes) -> Optional[dict]:
    """Mirrors JsonCacheFile._read()'s auto-detection so both zlib-compressed
    and plain-JSON backups are accepted."""
    if not raw:
        return None

    is_zlib = (
        len(raw) >= 2
        and (raw[0] & 0x0F) == 8
        and (raw[0] * 256 + raw[1]) % 31 == 0
    )
    if is_zlib:
        try:
            raw = zlib.decompress(raw)
        except zlib.error:
            return None

    try:
        obj = json.loads(raw.decode("utf-8", errors="replace"))
    except Exception:
        return None

    return obj if isinstance(obj, dict) else None


def restore_backup(path: str) -> tuple[bool, str]:
    """Reads a backup file (compressed or plain JSON) and restores it into
    storage. storage.write() then persists it back using storage's own
    format (zlib-compressed), so no extra .json file is created."""
    raw = file_utils.read_file_bytes(path)
    if raw is None:
        return False, "Could not read the selected file."

    obj = _decode_backup_bytes(raw)
    if obj is None:
        return False, "The selected file isn't a valid backup."

    storage.content = obj
    storage.write()
    logger.info(f"Restored backup from '{path}' ({len(obj)} entries).")
    return True, f"Restored {len(obj)} saved peers from backup."


class UserInfoSaver(BasePlugin):
    def on_plugin_load(self):
        clazz = jclass("org.telegram.messenger.MessagesController").getClass()
        hook_max_args_overload(self, clazz, "getPeerSettings", LoadPeerSettings())
        hook_max_args_overload(self, clazz, "savePeerSettings", SavePeerSettings())

        logger.info("Loaded.")

    def on_plugin_unload(self):
        logger.info("Unloaded.")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Backup"),
            Text(
                text="Restore from Backup",
                subtext="Pick a previously saved backup file and restore it.",
                icon="msg_restore",
                on_click=self._on_restore_click,
            ),
        ]

    def _on_restore_click(self, view):
        fragment = get_last_fragment()
        if not fragment:
            logger.warning("Cannot show restore dialog, no current fragment.")
            return

        activity = fragment.getParentActivity()
        if not activity:
            logger.warning("Cannot show restore dialog, no parent activity.")
            return

        candidates = find_backup_candidates()
        if not candidates:
            BulletinHelper.show_error(
                "No backup files found in the plugin cache or Documents folder.", fragment
            )
            return

        labels = [os.path.basename(p) for p in candidates]

        def on_pick(bld: AlertDialogBuilder, which: int):
            bld.dismiss()
            self._confirm_restore(candidates[which], activity, fragment)

        picker = AlertDialogBuilder(activity)
        picker.set_title("Select Backup File")
        picker.set_items(labels, on_pick)
        picker.set_negative_button("Cancel", lambda b, w: b.dismiss())
        picker.show()

    def _confirm_restore(self, path: str, activity, fragment):
        def on_confirm(bld: AlertDialogBuilder, which: int):
            bld.dismiss()
            ok, message = restore_backup(path)
            if ok:
                BulletinHelper.show_success(message, fragment)
            else:
                BulletinHelper.show_error(message, fragment)

        confirm = AlertDialogBuilder(activity)
        confirm.set_title("Restore Backup?")
        confirm.set_message(
            f"This will overwrite your current saved data with:\n{os.path.basename(path)}"
        )
        confirm.set_positive_button("Restore", on_confirm)
        confirm.set_negative_button("Cancel", lambda b, w: b.dismiss())
        confirm.create()
        confirm.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        confirm.show()
